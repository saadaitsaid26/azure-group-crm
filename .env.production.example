# Production Environment Variables

# Database Configuration
DB_NAME=crm
DB_USER=app
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Django Settings
SECRET_KEY=CHANGE_THIS_TO_LONG_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# CORS & CSRF
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
COOKIE_DOMAIN=yourdomain.com

# Frontend
VITE_API_URL=https://api.yourdomain.com/api/v1

# Email (if using SendGrid, AWS SES, etc.)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=YOUR_SENDGRID_API_KEY

# Azure Storage (for file uploads)
AZURE_ACCOUNT_NAME=your-storage-account
AZURE_ACCOUNT_KEY=your-storage-key
AZURE_CONTAINER=crm-files
