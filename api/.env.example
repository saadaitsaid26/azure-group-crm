# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DATABASE_URL=postgresql://app:app@localhost:5432/crm
# Or use individual settings:
# DB_NAME=crm
# DB_USER=app
# DB_PASSWORD=app
# DB_HOST=localhost
# DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
COOKIE_DOMAIN=localhost

# JWT Settings
SIMPLEJWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
SIMPLEJWT_REFRESH_TOKEN_LIFETIME_DAYS=7
SIMPLEJWT_ROTATE_REFRESH_TOKENS=True
SIMPLEJWT_COOKIE_SECURE=False
SIMPLEJWT_COOKIE_SAMESITE=Lax

# CSRF Settings
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080

# Azure Storage (Optional - for file uploads)
# AZURE_ACCOUNT_NAME=your-storage-account
# AZURE_ACCOUNT_KEY=your-storage-key
# AZURE_CONTAINER=crm-files
